{
  "name": "Tasks",
  "short_name": "Tasks",
  "description": "Cyberpunk terminal-themed task tracker.",
  "start_url": ".",
  "display": "standalone",
  "background_color": "#05070a",
  "theme_color": "#05070a",
  "share_target": {
    "action": "research/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "files", "accept": ["image/*"] }] }
  },
  "shortcuts": [
    { "name": "Research", "url": "research/", "icons": [{ "src": "research/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Journal", "url": "journal/", "icons": [{ "src": "journal/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Guild", "url": "adventurer/", "icons": [{ "src": "icon-guild-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ]
}
