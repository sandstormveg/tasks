{
  "name": "Living Journal",
  "short_name": "Journal",
  "description": "A private, local-first journal that keeps your words, connects them over time, and helps you reflect.",
  "id": "./",
  "start_url": "./#/today",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f2ea",
  "theme_color": "#f6f2ea",
  "categories": ["lifestyle", "productivity", "health"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Write", "url": "./#/today", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Talk it through", "url": "./#/talk", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Reflect", "url": "./#/reflect", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
